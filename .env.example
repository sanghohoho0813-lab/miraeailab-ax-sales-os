# 미래AI랩 AX Partner OS — 환경변수 예시. .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)
#
# 데이터 모드
#   local    — 브라우저 localStorage 데모 (로그인 없음, 시연·개발용)
#   supabase — 미래AI랩 공용 Supabase 프로젝트(mirae-ai-lab) 연결. 홈페이지·운영 OS 와 같은 프로젝트를 씁니다.
VITE_DATA_MODE=local

# supabase 모드에서만 필요. 홈페이지(miraeailab.com)·운영 OS 와 동일한 프로젝트 URL / anon 키.
# 브라우저에는 anon(또는 sb_publishable_) 키만 넣습니다. service_role / sb_secret_ 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# (선택) 운영 OS 주소 — 마스터 화면에서 "운영 OS에서 열기" 링크에 사용
VITE_OPS_OS_URL=https://ops.miraeailab.com

# (선택) AI 문장 보강 서버 엔드포인트 — 전략 핵심은 규칙으로 완성되며, 이 값이 없으면 AI 는 그냥 꺼져 있습니다.
# 브라우저에는 AI API Secret 을 절대 두지 않습니다. 이 URL 은 로그인 토큰을 검증하고 Provider 를 호출하는 서버(Supabase Edge Function 등)입니다.
# VITE_AI_ENHANCER_URL=https://your-project-ref.supabase.co/functions/v1/strategy-enhance
